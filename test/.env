# Configuration of the containerized SecObserve used for development and
# acceptance tests. Every value here is test-only and intentionally committed.

# SecObserve release to test against. Must match client.SchemaVersion in
# internal/client/status.go and the vendored api/openapi.json.
SECOBSERVE_VERSION=1.59.1

# Bootstrapped superuser. The provider needs a superuser token, see
# docs/design/api-quirks.md.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# Not secrets: a throwaway database in a throwaway container.
POSTGRES_DB=secobserve
POSTGRES_USER=secobserve
POSTGRES_PASSWORD=secobserve

# TEST ONLY. Taken from the upstream example compose file so the values are
# stable across runs. Never reuse these anywhere real.
DJANGO_SECRET_KEY=NxYPEF5lNGgk3yonndjSbwP77uNJxOvfKTjF5aVBqsHktNlf1wfJHHvJ8iifk32r
FIELD_ENCRYPTION_KEY=DtlkqVb3wlaVdJK_BU-3mB4wwuuf8xx8YNInajiJ7GU=
